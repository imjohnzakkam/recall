# recall configuration.
# Copy the RECALL_* block to ~/.recall/env (git-ignored); init.zsh sources it.
# The OPENAI_* block is what Supermemory Local reads to use Ollama for
# extraction — export these BEFORE booting `supermemory-server`.

# --- recall (sourced by init.zsh, read by the python scripts) ---
export RECALL_BASE="http://localhost:6767"
export RECALL_TAG="recall_$(hostname -s)"   # one memory space per machine
export RECALL_KEY="sm_..."                  # the key supermemory prints on first boot

# --- Supermemory Local -> Ollama (extraction LLM; embeddings are built in) ---
export OPENAI_BASE_URL="http://localhost:11434/v1"
export OPENAI_API_KEY="ollama"
export OPENAI_MODEL="qwen3:8b"              # bump to qwen3:14b / gpt-oss:20b for more quality
